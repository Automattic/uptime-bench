{
  "library_dir": "/var/lib/uptime-bench/certs",
  "state_dir": "/var/lib/uptime-bench-certmint",
  "lock_path": "/var/lib/uptime-bench-certmint/certmint.lock",
  "poll_interval": "15m",
  "inter_order_quiet": "60s",
  "expired_retention": "720h",
  "certbot": {
    "binary": "certbot",
    "email": "ops@example.com",
    "agree_tos": true,
    "staging": true,
    "config_dir": "/var/lib/uptime-bench-certmint/letsencrypt",
    "work_dir": "/var/lib/uptime-bench-certmint/work",
    "logs_dir": "/var/log/uptime-bench-certmint",
    "issuance_timeout": "10m",
    "authenticator_args": [
      "--manual",
      "--preferred-challenges", "dns",
      "--manual-auth-hook",    "/usr/local/bin/uptime-bench-acme-auth",
      "--manual-cleanup-hook", "/usr/local/bin/uptime-bench-acme-cleanup"
    ]
  },
  "domains": [
    {
      "name": "bench.example.com",
      "identifiers": [
        "bench.example.com",
        "*.bench.example.com"
      ],
      "unique_san_template": "cert-{date}-{slot}-{profile}.unique.bench.example.com",
      "profiles": [
        {
          "name": "classic",
          "per_day": 1
        },
        {
          "name": "shortlived",
          "required_profile": "shortlived",
          "max_lifetime": "168h",
          "per_day": 2
        }
      ]
    }
  ]
}
